generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

enum PolicyType {
  LIFE
  HEALTH
  VEHICLE
  HOME
  TRAVEL
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  NET_BANKING
  CHEQUE
}

enum DocumentType {
  ID_PROOF
  ADDRESS_PROOF
  POLICY
  CLAIM
  OTHER
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String
  role     Role
  isActive Boolean @default(true)

  customer       Customer?
  policies       Policy[]       @relation("AgentPolicies")
  reviewedClaims Claim[]        @relation("ClaimReviewer")
  notifications  Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
}

model Customer {
  id     String @id @default(cuid())
  userId String @unique

  dob            DateTime
  phone          String
  address        String
  city           String
  state          String
  pincode        String
  identityNumber String?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  policies  Policy[]
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
}

model Policy {
  id String @id @default(cuid())

  customerId String
  agentId    String

  policyNumber String     @unique
  policyType   PolicyType

  coverageAmount Decimal @db.Decimal(12, 2)
  premiumAmount  Decimal @db.Decimal(12, 2)

  startDate DateTime
  endDate   DateTime

  status PolicyStatus @default(ACTIVE)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  agent    User     @relation("AgentPolicies", fields: [agentId], references: [id])

  payments  PremiumPayment[]
  claims    Claim[]
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([agentId])
  @@index([status])
}

model PremiumPayment {
  id String @id @default(cuid())

  policyId String

  amount        Decimal        @db.Decimal(12, 2)
  dueDate       DateTime
  paymentDate   DateTime?
  paymentMethod PaymentMethod?

  transactionId String?

  status PaymentStatus @default(PENDING)

  billingCycle String?

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([policyId, dueDate])
  @@index([policyId])
  @@index([status])
}

model Claim {
  id String @id @default(cuid())

  policyId String

  claimAmount Decimal @db.Decimal(12, 2)

  reason       String
  description  String
  incidentDate DateTime

  status ClaimStatus @default(PENDING)

  reviewedById String?

  reviewedBy User? @relation("ClaimReviewer", fields: [reviewedById], references: [id])

  reviewedAt DateTime?
  remarks    String?

  submissionDate DateTime @default(now())

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([policyId])
  @@index([status])
}

model Document {
  id String @id @default(cuid())

  customerId String?
  policyId   String?
  claimId    String?

  documentType DocumentType

  fileName String
  filePath String
  fileType String

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  policy   Policy?   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  claim    Claim?    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  uploadedAt DateTime @default(now())

  @@index([customerId])
  @@index([policyId])
  @@index([claimId])
}

model Notification {
  id String @id @default(cuid())

  userId String

  title   String
  message String

  isRead Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}
