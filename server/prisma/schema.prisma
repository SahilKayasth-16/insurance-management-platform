generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  password       String
  role           Role
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  reviewedClaims Claim[]        @relation("ClaimReviewer")
  customer       Customer?
  notifications  Notification[]
  policies       Policy[]       @relation("AgentPolicies")

  @@index([email])
  @@index([role])
}

model Customer {
  id             String     @id @default(cuid())
  userId         String     @unique
  dob            DateTime
  phone          String
  address        String
  city           String
  state          String
  pincode        String
  identityNumber String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents      Document[]
  policies       Policy[]

  @@index([phone])
}

model Policy {
  id             String           @id @default(cuid())
  customerId     String
  agentId        String
  policyNumber   String           @unique
  policyType     PolicyType
  coverageAmount Decimal          @db.Decimal(12, 2)
  premiumAmount  Decimal          @db.Decimal(12, 2)
  startDate      DateTime
  endDate        DateTime
  status         PolicyStatus     @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  claims         Claim[]
  documents      Document[]
  agent          User             @relation("AgentPolicies", fields: [agentId], references: [id])
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments       PremiumPayment[]

  @@index([customerId])
  @@index([agentId])
  @@index([status])
}

model PremiumPayment {
  id            String         @id @default(cuid())
  policyId      String
  amount        Decimal        @db.Decimal(12, 2)
  paymentDate   DateTime?
  paymentMethod PaymentMethod?
  transactionId String?
  status        PaymentStatus  @default(PENDING)
  createdAt     DateTime       @default(now())
  billingCycle  String?
  dueDate       DateTime
  policy        Policy         @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, dueDate])
  @@index([policyId])
  @@index([status])
}

model Claim {
  id             String      @id @default(cuid())
  policyId       String
  claimAmount    Decimal     @db.Decimal(12, 2)
  reason         String
  status         ClaimStatus @default(PENDING)
  reviewedAt     DateTime?
  remarks        String?
  submissionDate DateTime    @default(now())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  description    String
  incidentDate   DateTime
  reviewedById   String?
  policy         Policy      @relation(fields: [policyId], references: [id], onDelete: Cascade)
  reviewedBy     User?       @relation("ClaimReviewer", fields: [reviewedById], references: [id])
  documents      Document[]

  @@index([policyId])
  @@index([status])
}

model Document {
  id           String       @id @default(cuid())
  customerId   String?
  policyId     String?
  claimId      String?
  documentType DocumentType
  fileName     String
  filePath     String
  fileType     String
  uploadedAt   DateTime     @default(now())
  claim        Claim?       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  policy       Policy?      @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([policyId])
  @@index([claimId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

enum PolicyType {
  LIFE
  HEALTH
  VEHICLE
  HOME
  TRAVEL
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  NET_BANKING
  CHEQUE
}

enum DocumentType {
  ID_PROOF
  ADDRESS_PROOF
  POLICY
  CLAIM
  OTHER
}
